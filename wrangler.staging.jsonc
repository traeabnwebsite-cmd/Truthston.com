{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truthston-modular-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SITE_MODE": "prototype"
  },
  "account_id": "90e7a4da02e47f49eb819dd595f1f430",
  "workers_dev": true,
  "preview_urls": true,
  "routes": []
}
