{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "truthston-auth-local-proof",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "vars": {"PROOF_MODE": "local-only"},
  "d1_databases": [{"binding":"AUTH_DB","database_name":"truthston-auth-local-proof","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
